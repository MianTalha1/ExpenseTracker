# Docker API Environment Variables
# Use this file with: docker run --env-file docker-api-env ...
# Copy this file and fill in your actual values

# Server Configuration
NODE_ENV=production
API_PORT=3001

# Frontend URL (for CORS)
# For local Docker: http://localhost:3000
# For production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK (required)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OpenRouter AI Integration (optional - for AI features)
# Get API key from https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# App URL (for OpenRouter referrer)
APP_URL=http://localhost:3001
