# =============================================================================
# Casha Tracker API - Environment Configuration (Firebase Version)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Environment: development | production | test
NODE_ENV=development

# API server port
API_PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Firebase Admin SDK Configuration
# -----------------------------------------------------------------------------

# Firebase project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase service account email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Firebase private key (from service account JSON)
# Replace \n with actual newlines or escape them
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AI Integration (Required for AI features)
# -----------------------------------------------------------------------------

# OpenRouter API key for AI-powered insights
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenRouter model to use (default: anthropic/claude-3-haiku)
# Options: anthropic/claude-3-haiku, openai/gpt-3.5-turbo, etc.
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Application URL (used for OpenRouter referer header)
APP_URL=http://localhost:3001
