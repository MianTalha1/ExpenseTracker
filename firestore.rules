rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      // Income sources subcollection
      match /incomeSources/{incomeId} {
        allow read, write: if isOwner(userId);
      }

      // Daily recommendations subcollection
      match /dailyRecommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }

      // Chat conversations subcollection
      match /chatConversations/{conversationId} {
        allow read, write: if isOwner(userId);

        // Chat messages nested subcollection
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}
